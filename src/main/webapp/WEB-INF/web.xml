<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <!-- NFR04: tự đăng xuất sau 30 phút không thao tác -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- ===== Đường dẫn (URL) của ứng dụng; các trang JSP nằm trong WEB-INF/views nên không truy cập trực tiếp được ===== -->
    <!-- /home : Trang chủ -->
    <servlet>
        <servlet-name>home</servlet-name>
        <jsp-file>/WEB-INF/views/thanhvien/gdHome9.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>home</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>
    <!-- /register : GET: form đăng kí; POST: doRegister9.jsp -->
    <servlet>
        <servlet-name>register</servlet-name>
        <jsp-file>/WEB-INF/views/thanhvien/gdRegister9.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>register</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>
    <!-- /login : GET: form đăng nhập; POST: doLogin9.jsp -->
    <servlet>
        <servlet-name>login</servlet-name>
        <jsp-file>/WEB-INF/views/thanhvien/gdLogin9.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>login</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <!-- /logout : Đăng xuất -->
    <servlet>
        <servlet-name>logout</servlet-name>
        <jsp-file>/WEB-INF/views/thanhvien/doLogout9.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>logout</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    <!-- /manager : Trang chính NV quản lí -->
    <servlet>
        <servlet-name>managerHome</servlet-name>
        <jsp-file>/WEB-INF/views/quanli/gdManagerMain9.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>managerHome</servlet-name>
        <url-pattern>/manager</url-pattern>
    </servlet-mapping>
    <!-- /manager/reports : Chọn loại thống kê -->
    <servlet>
        <servlet-name>reports</servlet-name>
        <jsp-file>/WEB-INF/views/quanli/gdSelectReport9.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>reports</servlet-name>
        <url-pattern>/manager/reports</url-pattern>
    </servlet-mapping>
    <!-- /manager/reports/product-revenue : ?startDate=yyyy-MM-dd&endDate=yyyy-MM-dd -->
    <servlet>
        <servlet-name>productRevenue</servlet-name>
        <jsp-file>/WEB-INF/views/quanli/gdRevenueStat9.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>productRevenue</servlet-name>
        <url-pattern>/manager/reports/product-revenue</url-pattern>
    </servlet-mapping>
    <!-- /manager/reports/product-revenue/detail : ?productId=&startDate=&endDate= -->
    <servlet>
        <servlet-name>productRevenueDetail</servlet-name>
        <jsp-file>/WEB-INF/views/quanli/gdProductDetail9.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>productRevenueDetail</servlet-name>
        <url-pattern>/manager/reports/product-revenue/detail</url-pattern>
    </servlet-mapping>
    <!-- /manager/reports/product-revenue/transactions : ?productId=&startDate=&endDate= -->
    <servlet>
        <servlet-name>productTransactions</servlet-name>
        <jsp-file>/WEB-INF/views/quanli/gdTransactionHistory9.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>productTransactions</servlet-name>
        <url-pattern>/manager/reports/product-revenue/transactions</url-pattern>
    </servlet-mapping>
</web-app>